generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  email     String
  name      String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reminders         Reminder[]
  bills             Bill[]
  subscriptions     Subscription[]
  expenses          Expense[]
  budgets           Budget[]
  folders           Folder[]
  tasks             Task[]
  documents         Document[]
  conversations     Conversation[]
  notificationPrefs NotificationPreference?
  notifications     Notification[]
  notificationLogs  NotificationLog[]
  pendingAiActions  PendingAiAction[]

  @@map("profiles")
}

enum ReminderStatus {
  PENDING
  COMPLETED
  OVERDUE
  DISMISSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

model Reminder {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  title           String
  description     String?
  dueDate         DateTime       @map("due_date")
  status          ReminderStatus @default(PENDING)
  priority        Priority       @default(MEDIUM)
  recurrenceType  RecurrenceType @default(NONE) @map("recurrence_type")
  recurrenceValue Int?           @map("recurrence_value")
  notifyBefore    Int            @default(60) @map("notify_before")
  notifiedAt      DateTime?      @map("notified_at")
  completedAt     DateTime?      @map("completed_at")
  parentId        String?        @map("parent_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  profile          Profile           @relation(fields: [userId], references: [userId])
  parent           Reminder?         @relation("RecurrenceChain", fields: [parentId], references: [id])
  children         Reminder[]        @relation("RecurrenceChain")
  notifications    Notification[]
  notificationLogs NotificationLog[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("reminders")
}

enum BillStatus {
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

enum BillCategory {
  UTILITIES
  RENT
  INSURANCE
  INTERNET
  PHONE
  MEDICAL
  EDUCATION
  ENTERTAINMENT
  FOOD
  TRANSPORT
  SHOPPING
  OTHER
}

model Bill {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  title         String
  description   String?
  provider      String?
  amount        Decimal      @db.Decimal(12, 2)
  currency      String       @default("INR")
  dueDate       DateTime     @map("due_date")
  paymentDate   DateTime?    @map("payment_date")
  category      BillCategory @default(OTHER)
  status        BillStatus   @default(UNPAID)
  isRecurring   Boolean      @default(false) @map("is_recurring")
  billingCycle  BillingCycle? @map("billing_cycle")
  notes         String?
  attachmentUrl String?      @map("attachment_url")
  attachmentPath String?     @map("attachment_path")
  documentId    String?      @map("document_id")
  invoiceNumber String?      @map("invoice_number")
  parentId      String?      @map("parent_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  profile  Profile   @relation(fields: [userId], references: [userId])
  document Document? @relation("LegacyDocumentBills", fields: [documentId], references: [id])
  linkedDocuments Document[] @relation("DocumentBillAssociation")
  parent   Bill?     @relation("BillRecurrenceChain", fields: [parentId], references: [id])
  children Bill[]    @relation("BillRecurrenceChain")
  notifications Notification[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("bills")
}

enum BillingCycle {
  MONTHLY
  YEARLY
  QUARTERLY
  WEEKLY
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAUSED
  EXPIRED
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String             @map("user_id")
  name               String
  description        String?
  provider           String?
  amount             Decimal            @db.Decimal(12, 2)
  currency           String             @default("INR")
  billingCycle       BillingCycle       @default(MONTHLY) @map("billing_cycle")
  startDate          DateTime           @map("start_date")
  nextRenewal        DateTime           @map("next_renewal")
  status             SubscriptionStatus @default(ACTIVE)
  category           String?
  notes              String?
  paymentMethod      String?            @map("payment_method")
  websiteUrl         String?            @map("website_url")
  isTrial            Boolean            @default(false) @map("is_trial")
  trialStartDate     DateTime?          @map("trial_start_date")
  trialEndDate       DateTime?          @map("trial_end_date")
  reminderDaysBefore Int?               @default(3) @map("reminder_days_before")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancellationReason String?            @map("cancellation_reason")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [userId])
  documents Document[]
  notifications Notification[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, nextRenewal])
  @@map("subscriptions")
}

enum ExpenseCategory {
  FOOD
  GROCERIES
  TRANSPORT
  HOUSING
  UTILITIES
  ENTERTAINMENT
  HEALTHCARE
  EDUCATION
  SHOPPING
  RENT
  INSURANCE
  SAVINGS
  INVESTMENT
  PERSONAL
  PERSONAL_CARE
  TRAVEL
  OTHER
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  UPI
  NET_BANKING
  WALLET
  OTHER
}

model Expense {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  title         String
  description   String?
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("INR")
  category      ExpenseCategory @default(OTHER)
  date          DateTime
  paymentMethod PaymentMethod?  @map("payment_method")
  merchant      String?
  notes         String?
  receiptUrl    String?         @map("receipt_url")
  receiptPath   String?         @map("receipt_path")
  tags          String[]        @default([])
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [userId])
  documents Document[]
  notifications Notification[]

  @@index([userId])
  @@index([userId, date])
  @@index([userId, category])
  @@map("expenses")
}

model Budget {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  month     Int              // 1 - 12
  year      Int              // e.g. 2026
  amount    Decimal          @db.Decimal(12, 2)
  currency  String           @default("INR")
  category  ExpenseCategory? // null means overall monthly budget
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@unique([userId, month, year, category])
  @@index([userId, month, year])
  @@map("budgets")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Task {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  dueDate     DateTime?  @map("due_date")
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("tasks")
}

enum DocumentType {
  PDF
  IMAGE
  INVOICE
  RECEIPT
  WORD
  SPREADSHEET
  TEXT
  OTHER
}

enum DocumentCategory {
  IDENTITY
  EDUCATION
  EMPLOYMENT
  FINANCIAL
  INSURANCE
  MEDICAL
  LEGAL
  PERSONAL
  OTHER
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Folder {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  name      String
  color     String?    @default("#64748b")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  profile   Profile    @relation(fields: [userId], references: [userId])
  documents Document[]

  @@unique([userId, name])
  @@index([userId])
  @@map("folders")
}

model Document {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  name             String
  originalName     String           @map("original_name")
  description      String?
  mimeType         String           @map("mime_type")
  size             Int
  storagePath      String           @map("storage_path")
  publicUrl        String?          @map("public_url")
  documentType     DocumentType     @default(OTHER) @map("document_type")
  category         DocumentCategory @default(OTHER)
  tags             String[]         @default([])
  folderId         String?          @map("folder_id")
  billId           String?          @map("bill_id")
  expenseId        String?          @map("expense_id")
  subscriptionId   String?          @map("subscription_id")
  processingStatus ProcessingStatus @default(PENDING) @map("processing_status")
  extractedData    Json?            @map("extracted_data")
  processingError  String?          @map("processing_error")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  profile      Profile       @relation(fields: [userId], references: [userId])
  folder       Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  bill         Bill?         @relation("DocumentBillAssociation", fields: [billId], references: [id], onDelete: SetNull)
  expense      Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  bills        Bill[]        @relation("LegacyDocumentBills")

  @@index([userId])
  @@index([userId, category])
  @@index([userId, folderId])
  @@index([userId, processingStatus])
  @@map("documents")
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String    @default("New Conversation")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  profile  Profile   @relation(fields: [userId], references: [userId])
  messages Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String
  toolCalls      Json?       @map("tool_calls")
  toolResults    Json?       @map("tool_results")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model NotificationPreference {
  id                     String   @id @default(uuid())
  userId                 String   @unique @map("user_id")
  emailEnabled           Boolean  @default(false) @map("email_enabled")
  inAppEnabled           Boolean  @default(true) @map("in_app_enabled")
  reminderLeadMinutes    Int      @default(60) @map("reminder_lead_minutes")
  billLeadDays           Int      @default(3) @map("bill_lead_days")
  subscriptionLeadDays   Int      @default(7) @map("subscription_lead_days")
  trialLeadDays          Int      @default(3) @map("trial_lead_days")
  budgetThresholdPercent Int      @default(80) @map("budget_threshold_percent")
  quietHoursEnabled      Boolean  @default(false) @map("quiet_hours_enabled")
  quietHoursStart        String?  @default("22:00") @map("quiet_hours_start")
  quietHoursEnd          String?  @default("08:00") @map("quiet_hours_end")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("notification_preferences")
}

enum NotificationType {
  REMINDER_DUE
  REMINDER_UPCOMING
  BILL_DUE
  BILL_OVERDUE
  SUBSCRIPTION_RENEWAL
  TRIAL_ENDING
  BUDGET_WARNING
  BUDGET_EXCEEDED
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

model Notification {
  id             String               @id @default(uuid())
  userId         String               @map("user_id")
  type           NotificationType
  title          String
  body           String
  priority       NotificationPriority @default(NORMAL)
  status         NotificationStatus   @default(UNREAD)
  link           String?
  reminderId     String?              @map("reminder_id")
  billId         String?              @map("bill_id")
  subscriptionId String?              @map("subscription_id")
  expenseId      String?              @map("expense_id")
  idempotencyKey String?              @unique @map("idempotency_key")
  metadata       Json?
  emailSent      Boolean              @default(false) @map("email_sent")
  emailSentAt    DateTime?            @map("email_sent_at")
  readAt         DateTime?            @map("read_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  profile      Profile       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  reminder     Reminder?     @relation(fields: [reminderId], references: [id], onDelete: SetNull)
  bill         Bill?         @relation(fields: [billId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  expense      Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ScheduledJobLog {
  id          String    @id @default(uuid())
  jobName     String    @map("job_name")
  status      String    // "RUNNING", "COMPLETED", "FAILED"
  stats       Json?
  error       String?
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  durationMs  Int?      @map("duration_ms")

  @@index([jobName, startedAt])
  @@map("scheduled_job_logs")
}

model NotificationLog {
  id         String             @id @default(uuid())
  userId     String             @map("user_id")
  reminderId String?            @map("reminder_id")
  type       NotificationType
  title      String
  body       String
  status     NotificationStatus @default(UNREAD)
  readAt     DateTime?          @map("read_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  profile  Profile   @relation(fields: [userId], references: [userId])
  reminder Reminder? @relation(fields: [reminderId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@map("notification_logs")
}

model PendingAiAction {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  actionType String   @map("action_type")
  actionData Json     @map("action_data")
  confirmed  Boolean  @default(false)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@map("pending_ai_actions")
}
