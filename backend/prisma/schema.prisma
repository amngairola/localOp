generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  email     String
  name      String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reminders         Reminder[]
  bills             Bill[]
  subscriptions     Subscription[]
  expenses          Expense[]
  tasks             Task[]
  documents         Document[]
  conversations     Conversation[]
  notificationPrefs NotificationPreference?
  notificationLogs  NotificationLog[]
  pendingAiActions  PendingAiAction[]

  @@map("profiles")
}

enum ReminderStatus {
  PENDING
  COMPLETED
  OVERDUE
  DISMISSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

model Reminder {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  title           String
  description     String?
  dueDate         DateTime       @map("due_date")
  status          ReminderStatus @default(PENDING)
  priority        Priority       @default(MEDIUM)
  recurrenceType  RecurrenceType @default(NONE) @map("recurrence_type")
  recurrenceValue Int?           @map("recurrence_value")
  notifyBefore    Int            @default(60) @map("notify_before")
  notifiedAt      DateTime?      @map("notified_at")
  completedAt     DateTime?      @map("completed_at")
  parentId        String?        @map("parent_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  profile          Profile           @relation(fields: [userId], references: [userId])
  parent           Reminder?         @relation("RecurrenceChain", fields: [parentId], references: [id])
  children         Reminder[]        @relation("RecurrenceChain")
  notificationLogs NotificationLog[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("reminders")
}

enum BillStatus {
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

enum BillCategory {
  UTILITIES
  RENT
  INSURANCE
  INTERNET
  PHONE
  MEDICAL
  EDUCATION
  ENTERTAINMENT
  FOOD
  TRANSPORT
  SHOPPING
  OTHER
}

model Bill {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  title         String
  description   String?
  provider      String?
  amount        Decimal      @db.Decimal(12, 2)
  currency      String       @default("INR")
  dueDate       DateTime     @map("due_date")
  paymentDate   DateTime?    @map("payment_date")
  category      BillCategory @default(OTHER)
  status        BillStatus   @default(UNPAID)
  isRecurring   Boolean      @default(false) @map("is_recurring")
  billingCycle  BillingCycle? @map("billing_cycle")
  notes         String?
  attachmentUrl String?      @map("attachment_url")
  attachmentPath String?     @map("attachment_path")
  documentId    String?      @map("document_id")
  invoiceNumber String?      @map("invoice_number")
  parentId      String?      @map("parent_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  profile  Profile   @relation(fields: [userId], references: [userId])
  document Document? @relation(fields: [documentId], references: [id])
  parent   Bill?     @relation("BillRecurrenceChain", fields: [parentId], references: [id])
  children Bill[]    @relation("BillRecurrenceChain")

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("bills")
}

enum BillingCycle {
  MONTHLY
  YEARLY
  QUARTERLY
  WEEKLY
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAUSED
  EXPIRED
}

model Subscription {
  id           String             @id @default(uuid())
  userId       String             @map("user_id")
  name         String
  provider     String?
  amount       Decimal            @db.Decimal(12, 2)
  currency     String             @default("INR")
  billingCycle BillingCycle       @default(MONTHLY) @map("billing_cycle")
  startDate    DateTime           @map("start_date")
  nextRenewal  DateTime           @map("next_renewal")
  status       SubscriptionStatus @default(ACTIVE)
  category     String?
  notes        String?
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([userId, status])
  @@index([userId, nextRenewal])
  @@map("subscriptions")
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  UTILITIES
  ENTERTAINMENT
  HEALTHCARE
  EDUCATION
  SHOPPING
  RENT
  INSURANCE
  SAVINGS
  INVESTMENT
  PERSONAL
  TRAVEL
  OTHER
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  UPI
  NET_BANKING
  WALLET
  OTHER
}

model Expense {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  title         String
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("INR")
  category      ExpenseCategory @default(OTHER)
  date          DateTime
  paymentMethod PaymentMethod?  @map("payment_method")
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([userId, date])
  @@index([userId, category])
  @@map("expenses")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Task {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  dueDate     DateTime?  @map("due_date")
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("tasks")
}

enum DocumentType {
  PDF
  IMAGE
  INVOICE
  RECEIPT
  OTHER
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Document {
  id               String          @id @default(uuid())
  userId           String          @map("user_id")
  name             String
  originalName     String          @map("original_name")
  mimeType         String          @map("mime_type")
  size             Int
  storagePath      String          @map("storage_path")
  publicUrl        String?         @map("public_url")
  documentType     DocumentType    @default(OTHER) @map("document_type")
  processingStatus ProcessingStatus @default(PENDING) @map("processing_status")
  extractedData    Json?           @map("extracted_data")
  processingError  String?         @map("processing_error")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [userId])
  bills   Bill[]

  @@index([userId])
  @@index([userId, processingStatus])
  @@map("documents")
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String    @default("New Conversation")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  profile  Profile   @relation(fields: [userId], references: [userId])
  messages Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String
  toolCalls      Json?       @map("tool_calls")
  toolResults    Json?       @map("tool_results")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  emailEnabled    Boolean  @default(false) @map("email_enabled")
  inAppEnabled    Boolean  @default(true) @map("in_app_enabled")
  remindersBefore Int      @default(60) @map("reminders_before")
  billsBefore     Int      @default(3) @map("bills_before")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@map("notification_preferences")
}

enum NotificationType {
  REMINDER
  BILL_DUE
  SUBSCRIPTION_RENEWAL
  SYSTEM
}

enum NotificationStatus {
  PENDING
  DELIVERED
  FAILED
  READ
}

model NotificationLog {
  id         String             @id @default(uuid())
  userId     String             @map("user_id")
  reminderId String?            @map("reminder_id")
  type       NotificationType
  title      String
  body       String
  status     NotificationStatus @default(PENDING)
  readAt     DateTime?          @map("read_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  profile  Profile   @relation(fields: [userId], references: [userId])
  reminder Reminder? @relation(fields: [reminderId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@map("notification_logs")
}

model PendingAiAction {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  actionType String   @map("action_type")
  actionData Json     @map("action_data")
  confirmed  Boolean  @default(false)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@map("pending_ai_actions")
}
