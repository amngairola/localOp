# ──────────────────────────────────────────────────────────────────────────────
# LifeOps Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ── Supabase Auth & Storage ──────────────────────────────────────────────────
# From Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Supabase PostgreSQL Database ─────────────────────────────────────────────
# Connection string (from Supabase > Settings > Database > Connection String)
# DATABASE_URL uses pooled connection (port 6543) for runtime transactions
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL uses direct connection (port 5432) for Prisma migrations
DIRECT_URL=postgresql://postgres.xxx:password@aws-0-region.supabase.com:5432/postgres

# ── Upstash Redis (Caching & Job Queues) ───────────────────────────────────────
# From https://console.upstash.com > Create Database > REST API / Redis URL
REDIS_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ── AI Providers (Model names configurable) ──────────────────────────────────
# Groq API: Natural language assistant & tool calling (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini API: Document understanding, OCR, invoice extraction (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Notifications & Background Jobs ──────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=LifeOps <notifications@lifeops.app>
TELEGRAM_BOT_TOKEN=
CRON_SECRET=lifeops-cron-secret-2026
